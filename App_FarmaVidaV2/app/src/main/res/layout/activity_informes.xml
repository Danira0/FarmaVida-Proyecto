<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityinformes">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="493dp"
        android:layout_height="970dp"
        android:contentDescription="Imagen de fondo"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/imag1" />

    <LinearLayout
        android:layout_width="252dp"
        android:layout_height="626dp"
        android:background="#66FFFFFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.464">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="100dp"
            android:layout_height="90dp"
            app:srcCompat="@drawable/imag2" />

        <TextView
            android:id="@+id/textVi2"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gestión de Informes"
            android:textAlignment="center"
            android:textColor="#D1C43D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Seleccione el tipo de informe:"
            android:textColor="#087481"
            android:textSize="14sp" />


        <!-- Spinner de PRODUCTOS -->
        <Spinner
            android:id="@+id/spinnerProductos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <!-- Spinner de MOVIMIENTOS -->
        <Spinner
            android:id="@+id/spinnerMovimientos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <!-- Spinner de LABORATORIOS -->
        <Spinner
            android:id="@+id/spinnerLaboratorios"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <!-- Spinner de USUARIOS -->
        <Spinner
            android:id="@+id/spinnerUsuarios"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/editTextConsultarNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="#FBF7D1"
            android:hint="Nombre"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColor="#3280A4"
            android:textColorHint="#087481"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#B8A509" />

        <Button
            android:id="@+id/buttonDescargarinforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#087481"
            android:elevation="3dp"
            android:padding="12dp"
            android:text="Descargar informe"
            android:textAllCaps="false"
            android:textColor="#FFE500"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>